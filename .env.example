# Arc mainnet (chain id 5042). Clearmark refuses to start against any other chain id.
# All three are optional; these are the defaults.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io

# ClearmarkPay contracts for checkout, one per token. Defaults to the deployed mainnet ones.
# NEXT_PUBLIC_CLEARMARK_PAY_USDC=0xEb7355de3d37D1130d0B3e8Ca2cA63fE4Ffdaf0b
# NEXT_PUBLIC_CLEARMARK_PAY_EURC=0x5de9f147cFC0406d1F23B3a2EEDfC8cF133dfDe8
# Set to "off" to send every payment through Arc's Memo contract instead.
# NEXT_PUBLIC_CLEARMARK_PAY=off

# Optional: WalletConnect Cloud project id (cloud.reown.com). Browser wallets like MetaMask and Rabby
# work without it; it adds QR-code / mobile wallet connections to the ConnectKit picker.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Secret used to sign merchant session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Key that encrypts stored accounting keys and tokens (Xero/QuickBooks). Generate with: openssl rand -hex 32
# Falls back to SESSION_SECRET. Changing it later means each merchant re-enters their app keys and reconnects.
CLEARMARK_SECRET_KEY=

# Where invoices, payments and receipts are stored (JSON file store for v1).
CLEARMARK_DATA_FILE=./data/clearmark-mainnet.json

# Set to 1 to show "Simulate payment" buttons that inject fake payments through the
# same reconciliation pipeline. Simulated payments are labelled and never touch the chain.
# Keep it off (0) on a live deployment that takes real payments.
CLEARMARK_DEMO=0

# Public origin used in receipt link previews (share cards). Optional: defaults to the request host.
# CLEARMARK_PUBLIC_URL=https://clearmark.example.com

# Euro invoices: EUR per 1 USD reference rate. Leave unset to use the ECB rate (frankfurter.app, cached 1h).
# CLEARMARK_EUR_PER_USD=0.92

# Optional Clearmark fee on USDC->EURC conversions via Circle Swap Kit (1-100 bps). Off unless both are set.
# NEXT_PUBLIC_CLEARMARK_SWAP_FEE_BPS=25
# NEXT_PUBLIC_CLEARMARK_FEE_RECIPIENT=0x...

# Hosting on Vercel: functions can't keep files, so store data in Upstash Redis (Vercel > Storage >
# Upstash for Redis sets these for you). Without them the app falls back to /tmp and data resets.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
